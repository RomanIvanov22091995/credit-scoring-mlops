# =============================================================================
# Frontend — nginx (unprivileged: uid 101, порт 8080, pid/кеш в /tmp).
# Статика + reverse-proxy на API.
# =============================================================================
FROM nginxinc/nginx-unprivileged:1.27-alpine

LABEL org.opencontainers.image.title="credit-scoring-frontend"

USER 101

RUN rm /etc/nginx/conf.d/default.conf
COPY --chown=101:101 frontend/nginx.conf /etc/nginx/conf.d/app.conf
COPY --chown=101:101 frontend/static/ /usr/share/nginx/html/

# nginx-unprivileged: /tmp для pid/cache уже настроен официальным образом
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
